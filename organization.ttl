@prefix o: <http://mee.foundation/ontologies/organization#> .
@prefix cco: <https://w3id.org/cco-domains/cco/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@base <http://mee.foundation/ontologies/organization> .

<http://mee.foundation/ontologies/organization> rdf:type owl:Ontology ;
    owl:versionIRI <http://mee.foundation/ontologies/organization/1.6.0> ;
    owl:imports <https://w3id.org/cco-domains/cco/AgentOntology> ;
    dc:date "2026-09-05"^^xsd:date ;
    owl:versionInfo "Version 1.6.0 - added o:numMembers (the number of members an Organization currently has)."@en ;
    rdfs:label "Organization Ontology"@en ;
    rdfs:comment """Organization Ontology for the Cellula App.
                    Describes organizations that participate in the Personal Data Network.
                    Peer of persona.ttl, cell.ttl, and pdn-identity.ttl."""@en .


#################################################################
#    Organization
#################################################################

o:Organization rdf:type owl:Class ;
    rdfs:subClassOf cco:ont00001180 ;  # CCO Organization (Group of Agents)
    rdfs:label "Organization"@en ;
    rdfs:comment """An organization (company, government agency, non-profit, etc.)
                    that participates in the Personal Data Network."""@en .

o:hasWebsite rdf:type owl:DatatypeProperty ;
    rdfs:domain o:Organization ;
    rdfs:range xsd:anyURI ;
    rdfs:label "has website"@en ;
    rdfs:comment "The organization's own public website URL."@en .

o:numMembers rdf:type owl:DatatypeProperty ;
    rdfs:domain o:Organization ;
    rdfs:range xsd:integer ;
    rdfs:label "number of members"@en ;
    rdfs:comment """The number of members the organization currently has. A plain count asserted by
                    whoever claims the graph, not derived from any modeled membership relation."""@en .
