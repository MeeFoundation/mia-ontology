    cell:isTopicCell true .

#################################################################
#  No category (Custom / UserDefined cells)
#################################################################

ctpl:UserDefinedTemplateCell rdf:type cell:Cell, cell:TemplateCell ;
    rdfs:label "User-Defined (No Category) Template Cell"@en ;
    rdfs:comment """The one cell:TemplateCell with no cell:category value at all — for a cell the
                    user creates without picking any existing category concept (the Custom/
                    UserDefined case, identified by its cell-databook filename's (custom)
                    disambiguator; see the Cell DataBook Filename Convention). Since it has no
                    cell:category, it isn't reachable by the usual ?tc cell:category cat:X
                    reverse lookup every other template cell uses — it's found instead as the
                    unique cell:TemplateCell carrying no cell:category value, and Lazy
                    Instantiation falls back to cloning it whenever a new cell is created with no
                    category selected. Carries only cell:memberGraphShape
                    pshapes:ContactInfoShape — a Custom cell has no document type and no
                    topic content of its own, only ever a business-card view of its member(s)."""@en ;
    cell:memberGraphShape pshapes:ContactInfoShape ;
    cell:isTopicCell false .

