@prefix cell: <http://mee.foundation/ontologies/cell#> .
@prefix ctpl: <http://mee.foundation/ontologies/cell-templates#> .
@prefix cat: <http://mee.foundation/ontologies/category#> .
@prefix pshapes: <http://mee.foundation/ontologies/persona/shapes#> .
@prefix petshapes: <http://mee.foundation/ontologies/pets/shapes#> .
@prefix vehicleshapes: <http://mee.foundation/ontologies/vehicles/shapes#> .
@prefix idocshapes: <http://mee.foundation/ontologies/identity-documents/shapes#> .
@prefix mashapes: <http://mee.foundation/ontologies/medical-appointments/shapes#> .
@prefix sashapes: <http://mee.foundation/ontologies/service-accounts/shapes#> .
@prefix bankingshapes: <http://mee.foundation/ontologies/banking/shapes#> .
@prefix residenceshapes: <http://mee.foundation/ontologies/residences/shapes#> .
@prefix itineraryshapes: <http://mee.foundation/ontologies/itineraries/shapes#> .
@prefix oshapes: <http://mee.foundation/ontologies/organization/shapes#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@base <http://mee.foundation/ontologies/cell-templates> .

<http://mee.foundation/ontologies/cell-templates> rdf:type owl:Ontology ;
    owl:versionIRI <http://mee.foundation/ontologies/cell-templates/2.23.0> ;
    dc:date "2026-09-05"^^xsd:date ;
    owl:imports <http://mee.foundation/ontologies/cell> ;
    owl:versionInfo "Version 2.23.0 - ctpl:AffiliationsTemplateCell flipped to cell:isTopicCell true, carrying cell:topicGraphShape oshapes:OrganizationShape"@en ;
    rdfs:label "Cell Templates"@en ;
    rdfs:comment """Class-level cell:Cell templates for category concepts (category.ttl's cat:CategoryScheme). Each individual here is what the app clones into a new cell when a folder representing its own cell:category concept is first instantiated into a user's tree (Lazy Instantiation) — finding the template for a given category is a reverse lookup (?tc cell:category cat:X), since category.ttl carries no forward pointer of its own. Each is typed solely cell:TemplateCell."""@en .

#################################################################
#  cat:Passport
#################################################################

ctpl:PassportTemplateCell rdf:type cell:Cell, cell:TemplateCell ;
    rdfs:label "Passport Template Cell"@en ;
    cell:category cat:Passport ;
    cell:memberGraphShape pshapes:ContactInfoShape ;
    cell:topicGraphShape idocshapes:PassportShape ;
    cell:isTopicCell true .

