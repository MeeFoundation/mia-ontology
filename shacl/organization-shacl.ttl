@prefix : <http://mee.foundation/ontologies/organization/shapes#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix o: <http://mee.foundation/ontologies/organization#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .

<http://mee.foundation/ontologies/organization/shapes> rdf:type owl:Ontology ;
    owl:imports <http://mee.foundation/ontologies/organization> ;
    owl:versionIRI <http://mee.foundation/ontologies/organization/shapes/1.2.0> ;
    dc:date "2026-09-05"^^xsd:date ;
    rdfs:label "Organization Ontology SHACL Validation Shapes"@en ;
    rdfs:comment "SHACL validation shapes for the Organization Ontology."@en .


#################################################################
#  Organization
#################################################################

:OrganizationShape
    a sh:NodeShape ;
    sh:targetClass o:Organization ;
    sh:message "Organization validation."@en ;

    # Both properties are optional — most organizations in the example data are
    # named only as a cell member or claimant, with no profile of their own.
    sh:property [
        sh:path o:hasWebsite ;
        sh:datatype xsd:anyURI ;
        sh:maxCount 1 ;
        sh:message "An Organization may have at most one website, an xsd:anyURI."@en
    ] ;
    sh:property [
        sh:path o:numMembers ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
        sh:maxCount 1 ;
        sh:message "An Organization may have at most one member count, a non-negative xsd:integer."@en
    ] .
